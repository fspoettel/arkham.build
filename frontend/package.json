{
  "name": "@arkham-build/frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "analyze": "npx vite-bundle-visualizer",
    "assets:grimoire": "node ./scripts/copy-grimoire-assets.ts",
    "build": "vite build",
    "check": "tsc --noEmit",
    "dev": "vite",
    "fmt:rules": "npx prettier src/assets/rules.html --write",
    "i18n:sync": "node ./scripts/i18n-sync.ts && cd .. && npm run fmt && cd frontend",
    "i18n:pull": "npx tsx ./scripts/i18n-pull.ts && cd .. && npm run fmt && cd frontend",
    "icons:export": "mkdir -p public/lucide && npm i lucide-static && cp -R node_modules/lucide-static/icons public/lucide && npm uninstall lucide-static",
    "knip": "npx knip",
    "preview": "vite preview",
    "schema:fan-made-content": "node ./scripts/fan-made-content-schema.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@floating-ui/react": "0.27.20",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-serif": "5.3.0",
    "@lucide/lab": "0.7.0",
    "@tanstack/react-query": "5.104.5",
    "dompurify": "3.4.17",
    "i18next": "26.5.6",
    "i18next-resources-to-backend": "1.2.3",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.61.0",
    "nanoid": "6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.3",
    "react-virtuoso": "4.18.19",
    "recharts": "3.10.1",
    "reselect": "5.3.0",
    "sonner": "2.0.8",
    "wouter": "3.13.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "oxc-transform-react": "0.152.0",
    "vite": "8.3.5"
  }
}
